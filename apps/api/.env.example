# Copy to apps/api/.env and configure your running PostgreSQL server.
# Better Auth uses WEB_URL as its public origin; /api is proxied by the web app locally.

# Steam login/linking: obtain your server-side key from https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=

# OpenDota public API works without a key within the provider's limits.
# OPENDOTA_API_KEY=

# Optional: enable AI match reviews and hero suggestions. Never use a frontend VITE_ variable.
# Create a project key at https://platform.openai.com/api-keys and restart the API.
# OPENAI_API_KEY=
OPENAI_REVIEW_MODEL=gpt-5.4-mini-2026-03-17
# Estimated spend in USD cents, shared in PostgreSQL. Zero blocks new paid work.
AI_REVIEW_DAILY_BUDGET_CENTS=50
AI_REVIEW_MONTHLY_BUDGET_CENTS=500
AI_REVIEW_USER_DAILY_LIMIT=5
# Latest saved reviews per user (25–200); summaries have a separate retention limit.
AI_REVIEW_RETENTION=100
# Hero picker shares the estimated global spend ceilings above, with its own attempts.
AI_DRAFT_USER_DAILY_LIMIT=30

# Cost controls: actual provider calls per UTC day, shared across API replicas.
OPENDOTA_DAILY_REQUEST_LIMIT=1000
# Retain newest 100–1,000 summaries per connected account; imports fetch up to 100.
HISTORY_MAX_MATCHES=1000
# All history imports/refreshes share this cooldown (30–3,600 seconds).
HISTORY_SYNC_COOLDOWN_SECONDS=60

# Default local email delivery writes into .data/mail; nothing is sent externally.
EMAIL_TRANSPORT=local

# Production email settings (requires a verified sending domain in Resend):
# EMAIL_TRANSPORT=resend
# RESEND_API_KEY=
# EMAIL_FROM=Tito <coach@your-domain.com>

# Required in development and production. Use your actual PostgreSQL credentials.
# db:migrate can create the named database when this role has CREATEDB permission.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tito

# Required for production; use a private random value of at least 32 characters.
# BETTER_AUTH_SECRET=

# Production also requires NODE_ENV=production and WEB_URL=https://your-app.example.com
# Override the ignored local email storage directory if necessary:
# DATA_DIR=/absolute/path/to/local/data
